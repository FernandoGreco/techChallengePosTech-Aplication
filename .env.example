DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oficina_mecanica?schema=public"
JWT_SECRET="sua-chave-secreta-jwt"
JWT_EXPIRES_IN="1d"
ORCAMENTO_ACTION_SECRET="gere-um-segredo-aleatorio-independente"
ORCAMENTO_ACTION_TOKEN_TTL_SECONDS=86400
PORT=3000
APP_URL=http://localhost:3000
# Opcional: endereço controlado por você para testar envio SMTP real.
# SEED_CLIENT_EMAIL=seu-email-de-teste

# Observabilidade (Datadog) — sem agente ativo a app roda em modo no-op
DD_SERVICE=oficina-mecanica-api
DD_ENV=development
# Para o Agent local opcional, preencha DD_API_KEY no .env (ignorado pelo Git).
# DD_API_KEY=
# DD_SITE=datadoghq.com
# DD_AGENT_HOST=localhost
